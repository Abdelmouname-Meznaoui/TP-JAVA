<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootContainer" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.MainController" styleClass="root-shell">
    <children>
        <BorderPane VBox.vgrow="ALWAYS">
            <left>
                <VBox prefWidth="270.0" styleClass="sidebar">
                    <padding>
                        <Insets bottom="24.0" left="20.0" right="20.0" top="24.0" />
                    </padding>
                    <children>
                        <Label text="FarmFlow" styleClass="brand-title" />
                        <Label text="Control Center" styleClass="brand-subtitle" />
                        <Separator styleClass="soft-separator" />
                        <Button fx:id="dashboardButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#showDashboard" styleClass="sidebar-button" text="Dashboard" />
                        <Button fx:id="zonesButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#showZones" styleClass="sidebar-button" text="Zones" />
                        <Button fx:id="alertsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#showAlerts" styleClass="sidebar-button" text="Alerts" />
                        <Region VBox.vgrow="ALWAYS" />
                        <VBox spacing="8.0" styleClass="card sidebar-note">
                            <children>
                                <Label text="Today" styleClass="note-title" />
                                <Label text="The dashboard is built to stay clean at large desktop sizes and comfortable on smaller windows too." wrapText="true" styleClass="note-body" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </left>
            <center>
                <VBox spacing="20.0" styleClass="content-shell">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="toolbar">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title" />
                                        <Label fx:id="pageSubtitleLabel" text="Farm pulse, performance, and key summaries" styleClass="page-subtitle" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#refreshCurrentPage" styleClass="toolbar-button" text="Refresh" />
                                <ToggleButton fx:id="themeToggle" mnemonicParsing="false" onAction="#toggleTheme" styleClass="toolbar-button" text="Light" />
                            </children>
                        </HBox>
                        <StackPane fx:id="contentHost" VBox.vgrow="ALWAYS" styleClass="content-host" />
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</VBox>
