<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ZonesController" styleClass="page-shell">
    <children>
        <HBox spacing="18.0">
            <children>
                <VBox spacing="14.0" styleClass="card panel-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                    </padding>
                    <children>
                        <Label text="Zone Registry" styleClass="panel-title" />
                        <TableView fx:id="zonesTable" columnResizePolicy="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" VBox.vgrow="ALWAYS" styleClass="glass-table">
                            <columns>
                                <TableColumn fx:id="codeColumn" prefWidth="90.0" text="Code" />
                                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Name" />
                                <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Type" />
                                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                                <TableColumn fx:id="entitiesColumn" prefWidth="110.0" text="Entities" />
                                <TableColumn fx:id="sensorsColumn" prefWidth="100.0" text="Sensors" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox prefWidth="320.0" spacing="14.0" styleClass="card panel-card form-card">
                    <children>
                        <Label text="Add Zone" styleClass="panel-title" />
                        <Label text="Create a new operating area with a clean, validated flow." styleClass="section-subtitle" wrapText="true" />
                        <Label text="Zone name" styleClass="input-label" />
                        <TextField fx:id="zoneNameField" promptText="Ex: Nursery East" styleClass="text-input" />
                        <Label text="Zone type" styleClass="input-label" />
                        <ComboBox fx:id="zoneTypeCombo" maxWidth="1.7976931348623157E308" styleClass="text-input" />
                        <Label text="Livestock profile" styleClass="input-label" />
                        <ComboBox fx:id="livestockTypeCombo" maxWidth="1.7976931348623157E308" styleClass="text-input" />
                        <Label fx:id="validationLabel" text="Ready to add a new operational zone." wrapText="true" styleClass="helper-text" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#createZone" styleClass="primary-button" text="Create Zone" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
